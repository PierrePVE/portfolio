# Copier en `.env` et adapter. Le `.env` réel n'est pas versionné.

# URL de l'application Récurra liée depuis le portfolio.
# - Vercel (sous-domaine dédié) : https://recurra-smoky.vercel.app
# - Freebox (reverse proxy)      : /recurra/  ou  https://pierrepve.ddns.net/recurra
NUXT_PUBLIC_RECURRA_URL=https://recurra-smoky.vercel.app

# Chemin de base du site (préfixe d'URL). Par défaut la racine "/".
# - Vercel (domaine dédié, site à la racine) : ne rien définir (défaut "/")
# - Freebox (reverse proxy, apps par segment) : /portfolio/
#   (déjà défini automatiquement dans le Dockerfile pour la cible Freebox)
# baseURL est figé au build : cette variable doit être présente au moment du build.
NUXT_APP_BASE_URL=/
