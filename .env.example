# Copier en `.env` et adapter. Le `.env` réel n'est pas versionné.

# URL de l'application Récurra liée depuis le portfolio.
# - Même domaine via reverse proxy : un chemin relatif suffit -> /recurra/
# - URL absolue (DNS) : https://pierrepve.ddns.net/recurra
NUXT_PUBLIC_RECURRA_URL=https://pierrepve.ddns.net/recurra

# Chemin de base du site (préfixe d'URL). Dépend de la cible de déploiement :
# - Freebox (reverse proxy, apps séparées par segment) : /portfolio/
# - Vercel (domaine dédié, site à la racine)           : /
# À définir au moment du build. Par défaut /portfolio/ (cf. nuxt.config.ts).
NUXT_APP_BASE_URL=/portfolio/
